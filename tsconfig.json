{
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2022",
        "lib": ["ES2022"],
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": true,
        "sourceMap": true,
        "noEmit": false,
        "types": ["node", "./worker-configuration.d.ts"]
    },
    "ts-node": {
        "esm": true
    },
    "include": [
        "src/**/*",
        "worker-configuration.d.ts"
    ],
    "exclude": ["node_modules", "dist"]
}
